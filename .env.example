# AI Provider Keys
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_NIM_KEY=your_nvidia_nim_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Authentication Configuration (username:password comma-separated)
APP_USERS=admin:admin123,kvothe:password123
JWT_SECRET=replace-with-a-random-secure-secret-key-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite or PostgreSQL)
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/chatdb

# Chatbot Defaults
DEFAULT_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash
DEFAULT_N_TURNS=5
MAX_DIRECT_CONTEXT_TOKENS=2500
